# Project settings for the factory scripts. Copy to $HERMES_HOME/factory.env.
# An environment variable with the same name overrides a line here.

# GitHub repository the factory works on, owner/name.
FACTORY_REPO=your-login/your-repo
# Main local clone of that repository on the host.
FACTORY_REPO_PATH=~/projects/your-repo
# Slug of the kanban board.
FACTORY_BOARD=main
# GitHub login of the owner: whose review is the final verdict.
FACTORY_OWNER_LOGIN=your-login
# Where owner alerts are delivered, as <platform>:<chat id>.
FACTORY_OWNER_CHAT=telegram:000000000
# Long-lived branches PRs are opened against, comma-separated.
FACTORY_BASE_BRANCHES=main
# Commit address of the agent's GitHub identity, printed by the pre-push
# identity guard when it refuses a commit made under a default address.
FACTORY_BOT_EMAIL=1234567+your-bot[bot]@users.noreply.github.com

# GitHub logins of the bot accounts that write "## Review verdict" comments,
# comma-separated. Without it the evening metrics recognise no reviewer verdict.
FACTORY_REVIEWER_LOGINS=your-bot

# --- Optional. Each line shows the default; uncomment to change. ---

# Footer line the bot writes into the issues that mirror kanban cards. The
# webhook filter drops issue events whose body carries it (the card exists).
#FACTORY_MIRROR_FOOTER='Mirrored from kanban card'
# Branches whose worktrees worktree-gc never removes.
#FACTORY_PROTECTED_BRANCHES=
# Scripts hermes-health checks for presence and syntax.
#FACTORY_GUARDED_SCRIPTS=board-watchdog.py,pr-hygiene.py

# Verdict vocabulary. These words are a contract with the prompts of the
# reviewer and the owner: change them only together with the skills.
#FACTORY_VERDICT_PASS_WORDS=PASS,APPROVED,ACCEPTED
#FACTORY_VERDICT_RETURN_WORDS='CHANGES REQUESTED,REQUEST CHANGES,RETURN'
#FACTORY_OWNER_ECHO_PREFIX='owner comment'
#FACTORY_PLAN_ACCEPT_WORDS=ACCEPTED,APPROVE
#FACTORY_PLAN_RETURN_WORDS=RETURN,REJECT
# Regex of plan topics that always require a plan review.
#FACTORY_CRITICAL_PATTERN='authoriz|oauth|\bauth\b|security|migration|\.github|\brelease'
# Model and provider for plan-review cards; empty means the reviewer profile's own.
#FACTORY_PLAN_REVIEW_MODEL=
#FACTORY_PLAN_REVIEW_PROVIDER=

# Regexes and values with ';', '|', spaces or backslashes stay in single
# quotes: shell scripts source this file.

# --- Provider-specific. No defaults: each key says what happens while it
# is unset. The values shown are examples, not recommendations. ---

# Peak-pricing window during which dispatch is held (peak-pause-tick): an IANA
# time zone, start and end (HH:MM, end exclusive). Unset (any of the three):
# the pause is off, the tick holds nothing and logs which keys are missing.
#FACTORY_PEAK_TZ=Asia/Singapore
#FACTORY_PEAK_START=09:00
#FACTORY_PEAK_END=13:00
# Weekdays of the window, 0=Mon. Unset: every day.
#FACTORY_PEAK_DAYS=0,1,2,3,4

# Quota guard of hermes-health: stops dispatch and LLM cron jobs when the
# provider reports a dead quota and resumes them when a 5-token probe answers.
# Base URL of the provider's OpenAI-compatible API, the name of the variable
# in the Hermes .env that holds its key, and the probe model (unset: the first
# fallback model of config.yaml). Unset: the guard is skipped with one line
# on stderr; the other health checks still run.
#FACTORY_QUOTA_PROBE_BASE=https://api.example-provider.com/v1
#FACTORY_QUOTA_PROBE_KEY_VAR=EXAMPLE_PROVIDER_API_KEY
#FACTORY_QUOTA_PROBE_MODEL=example-model-small
# Error codes the provider puts on a 429 line when the quota is gone, and the
# matching message texts (paired with the codes by position). Unset: no log
# line counts as quota death, so the guard never stops anything.
#FACTORY_QUOTA_CODES=1310,1113
#FACTORY_QUOTA_TEXTS='Limit Exhausted,Insufficient balance or no resource package'

# Prices for the evening spend report and usage-ledger, in your plan's
# credits: model=input/cache_read/output;... with credits of a call =
# (input_tokens * input + cache_tokens * cache_read + output_tokens * output)
# / 10000. Unset, or a model not listed: its cost is shown as unknown, never
# as zero. Example: the coefficients of one GLM coding plan (check your own).
#FACTORY_PRICES='glm-5.3=6.9/1.7/24;glm-5.3-flash=2.3/0.56/8'
# IANA time zone of the day and week boundaries in the spend report.
# Unset: UTC (the report header names the zone).
#FACTORY_REPORT_TZ=Europe/Berlin

# --- Board watchdog, PR hygiene, evening metrics ---

# Name of your project conventions skill, mentioned in cards the watchdog creates.
#FACTORY_CONVENTIONS_SKILL=project-conventions
# GitHub logins of the factory's own bot accounts, comma-separated. Issues
# they author are mirrors of cards, so the issue poll of the board watchdog
# creates no executor card for them. Empty: falls back to FACTORY_REVIEWER_LOGINS.
#FACTORY_BOT_LOGINS=
# Issue numbers exempt from the prototype-before-implementation gate.
# A dated owner decision each: keep the reason next to the number in your notes.
#FACTORY_PROTOTYPE_EXEMPT_ISSUES=
# Path prefixes that must change together (modules implementing one contract),
# and the sub-path inside them the rule applies to.
#FACTORY_PARITY_PATHS=
#FACTORY_PARITY_SCOPE=
# Branch prefix agents use for issue branches, <prefix><issue>-<slug>.
# pr-hygiene matches such a PR to the live card that owns it (key
# coder-<issue>-<slug>) and lets that card absorb a rebase.
#FACTORY_ISSUE_BRANCH_PREFIX=hermes/
# A release line declared end-of-life (for example release/1.x) and the line
# that stays. pr-hygiene flags open PR and issue bodies that still promise
# work on the retired line. Empty: the check is off.
#FACTORY_EOL_BRANCH=
#FACTORY_EOL_KEEP_BRANCH=
# Issue numbers whose visual-delta card the owner removed, comma-separated:
# pr-hygiene never recreates them.
#FACTORY_VISUAL_DELTA_SUPPRESSED=
# Model and provider pinned on mechanical cards (rebases). Empty: no pin.
#FACTORY_CHEAP_MODEL=
#FACTORY_CHEAP_PROVIDER=
# Milestone prefixes the metrics fall back to when detection fails.
#FACTORY_MILESTONES=
# Regex that recognises a build command in agent terminal calls, for the
# local-build lines of the evening waiting audit. Unset: those lines are
# skipped and the report says so. The two optional markers classify a build:
# a full verification run, and a run scoped to some modules (unset: no build
# counts as full or scoped). Example for Maven:
#FACTORY_BUILD_CMD_RE='\b(?:\./)?mvnw\b|\bmvn\s'
#FACTORY_BUILD_FULL_RE='\bverify\b'
#FACTORY_BUILD_SCOPE_RE='(?:^|\s)(?:-pl|--projects)\b'

# --- Visual delta (before/after screenshots of a UI change) ---
# Required for visual-delta-capture.py when a side is a git ref: the build
# command, the built artifact, and the stand start command ({artifact} and
# {port} are substituted). Unset: the capture stops with a FAIL line naming
# the key. Quote values with spaces: shell scripts source this file.
#FACTORY_STAND_BUILD_CMD="./build.sh --skip-tests"
#FACTORY_STAND_ARTIFACT_GLOB=app/build/*.jar
#FACTORY_STAND_RUN_CMD="java -Xmx512m -jar {artifact} --server.port={port}"
#FACTORY_STAND_DEPS_REL=
#FACTORY_STAND_ROUTE=/
# Headless browser binary the capture starts for itself. Unset: it uses the
# browser already listening on FACTORY_CDP_PORT.
#FACTORY_CHROME_BIN=/usr/bin/chromium
#FACTORY_CDP_PORT=9222
#FACTORY_ASSETS_BRANCH=hermes-assets
#FACTORY_ASSETS_DIR=

# --- Nightly holdout run ---
# Required for holdout-nightly-prep.sh.
#FACTORY_HOLDOUT_BUILD_CMD=
#FACTORY_HOLDOUT_ARTIFACT_GLOB=
# Extensions of product files: a PR that changes one gets an artifact.
# Unset: every changed file counts, so any PR with changes is built.
#FACTORY_HOLDOUT_PRODUCT_EXT=java,xml,ts,tsx
#FACTORY_HOLDOUT_DIFF_BASE=

# --- Append-only registry file (rebase-registry-pr.sh) ---
#FACTORY_REGISTRY_FILE=docs/PATCHES.txt
#FACTORY_BOT_NAME=factory-bot
